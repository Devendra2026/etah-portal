# Paste into Dokploy → Application → Environment.
# Toggle **Available at Buildtime** for every NEXT_PUBLIC_* key, then Save + Redeploy.
# Replace REPLACE_ME_* before first deploy.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_APP_URL=https://portal.nppetah.in
NEXT_PUBLIC_API_BASE_URL=/nest-api
NEST_API_ORIGIN=https://backend.sdvedutech.in

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_SATELLITE_DOMAIN=portal.nppetah.in
NEXT_PUBLIC_CLERK_PRIMARY_SIGN_IN_URL=https://admin.sdvedutech.in/sign-in
NEXT_PUBLIC_CLERK_PRIMARY_SIGN_UP_URL=https://admin.sdvedutech.in/sign-up
