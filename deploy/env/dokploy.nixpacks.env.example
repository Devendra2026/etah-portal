# Dokploy → Environment. Enable Available at Buildtime on every NEXT_PUBLIC_*.
# Then Rebuild. Build fails unless pk_live_ / sk_live_ are set (CI=true).
#
# Clerk: production instance for nppetah.in only. See docs/ops/clerk-production.md
# Nest: PORTAL_CLERK_SECRET_KEY must equal CLERK_SECRET_KEY below.

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
NEXT_TELEMETRY_DISABLED=1
CI=true

NEXT_PUBLIC_APP_URL=https://portal.nppetah.in
NEXT_PUBLIC_API_BASE_URL=/nest-api
NEST_API_ORIGIN=https://backend.sdvedutech.in

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_ENCRYPTION_KEY=REPLACE_ME_OPENSSL_RAND_BASE64_32
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
