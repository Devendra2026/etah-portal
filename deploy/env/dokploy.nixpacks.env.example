# Paste into Dokploy → Application → Environment.
# Toggle **Available at Buildtime** for every NEXT_PUBLIC_* key, then Rebuild.
#
# This portal uses ITS OWN Clerk application (nppetah.in).
# Do NOT set satellite vars. Do NOT use admin.sdvedutech.in Clerk live keys.
# Nest must also have PORTAL_CLERK_SECRET_KEY = this same CLERK_SECRET_KEY.
# Survey data still comes from https://backend.sdvedutech.in (Etah ULB).

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_APP_URL=https://portal.nppetah.in
NEXT_PUBLIC_API_BASE_URL=/nest-api
NEST_API_ORIGIN=https://backend.sdvedutech.in

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_REPLACE_ME_PORTAL_CLERK
CLERK_SECRET_KEY=sk_REPLACE_ME_PORTAL_CLERK
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
